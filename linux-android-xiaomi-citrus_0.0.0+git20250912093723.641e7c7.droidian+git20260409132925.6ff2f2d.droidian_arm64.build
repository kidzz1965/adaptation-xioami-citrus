fi; \
eval mkbootimg \
	${MKBOOTIMG_KERNEL_ARGS} \
	${MKBOOTIMG_OFFSET_ARGS} \
	--ramdisk out/KERNEL_OBJ/initramfs.recovery-default \
	--pagesize 4096 \
	--cmdline "\"console=ttyMSM0,115200n8 earlycon=msm_geni_serial,0x4a90000 androidboot.hardware=qcom androidboot.console=ttyMSM0 androidboot.memcg=1 lpm_levels.sleep_disabled=1 video=vfb:640x400,bpp=32,memsize=3072000 msm_rtb.filter=0x237 service_locator.enable=1 swiotlb=2048 loop.max_part=7 androidboot.fstab_suffix=default buildvariant=user droidian.lvm.prefer console=tty0\"" \
	${MKBOOTIMG_SPL_ARGS} \
	${MKBOOTIMG_OSV_ARGS} \
